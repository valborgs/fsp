<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 8.0-11 (API 26-30).
    The Room database holds the send queue and, later, responses and attendance. Its payloads are
    encrypted with an Android Keystore key that is never backed up, so a restored copy could not be
    decrypted anyway; it is excluded entirely. Tokens and the installation ID live in no_backup,
    which the platform never backs up.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
